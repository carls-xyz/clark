# Clark : copie ce fichier en .env (chmod 600), puis remplis ce qui te sert. Rien n'est obligatoire
# sauf un moteur. La plupart des réglages se changent aussi dans l'interface (Réglages › Général).

# ── Moteurs (au moins un) ─────────────────────────────────────────────
CLARK_ENGINE=                 # vide = celui qui est connecté ; claude, codex ou api
ANTHROPIC_API_KEY=            # Claude par clé d'API (sinon : claude auth login, abonnement)
OPENAI_API_KEY=               # Codex par clé d'API (sinon : codex login, compte ChatGPT)
OPENROUTER_API_KEY=           # autres IA, facultatif
MISTRAL_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_HOST=                  # si Ollama tourne ailleurs que sur localhost:11434

# ── Interface et accès depuis le téléphone ────────────────────────────
CLARK_WEB_PORT=4310
CLARK_WEB_HOSTS=              # ex. clark-vps.ton-reseau.ts.net (tailscale serve)
CLARK_TAILSCALE_USERS=        # ton compte Tailscale (conseillé)

# ── Telegram (les deux, ou aucune) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# ── Google (Gmail, Agenda) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Obsidian, navigateur, voix, shell ─────────────────────────────────
CLARK_OBSIDIAN_VAULT=         # chemin du coffre synchronisé
CLARK_BROWSER_EXECUTABLE=     # vide = trouvé seul (Mac : Google Chrome ; Linux : /usr/bin/google-chrome)
CLARK_WHISPER_BIN=            # vide = trouvé seul (Linux : /usr/local/bin/whisper-cli)
CLARK_FFMPEG_BIN=             # vide = ffmpeg du système
CLARK_SHELL=                  # vide = zsh s'il existe, sinon bash

# ── Rythme (se règle aussi dans l'interface) ──────────────────────────
CLARK_BRIEF_HOUR=9
CLARK_IDEAS_HOUR=15
CLARK_HEARTBEAT_MINUTES=120

# ── Dépenses (avec une clé d'API seulement) ───────────────────────────
CLARK_MAX_USD_PER_DAY=5
CLARK_MAX_USD_PER_TASK=1

# ── Supervision ───────────────────────────────────────────────────────
CLARK_ALERTS=on               # off : pas d'alertes de santé (la page Santé reste)
CLARK_PING_URL=               # ex. https://hc-ping.com/<ton-id> (healthchecks.io), appelé toutes les 5 min
CLARK_PING_FAIL_ON_BAD=       # 1 : signaler aussi « À régler » au service externe (<url>/fail) ; désactivé par défaut

# ── Sauvegardes hors machine (restic, chiffrées ; facultatif) ─────────
# Puis, une fois : scripts/backup.sh init. Garde le mot de passe dans ton gestionnaire : sans lui, rien ne se restaure.
CLARK_BACKUP_REPO=            # ex. b2:mon-bucket:clark, s3:s3.amazonaws.com/bucket/clark, sftp:moi@nas:/clark
CLARK_BACKUP_PASSWORD_FILE=   # fichier (chmod 600, hors du dossier de Clark) qui contient le mot de passe du dépôt
B2_ACCOUNT_ID=                # identifiants du stockage (B2), ou AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (S3)
B2_ACCOUNT_KEY=
CLARK_BACKUP_GOOGLE=on        # off : ne pas sauvegarder la connexion Google
CLARK_BACKUP_DRILL_DAY=7      # exercice de restauration : jour (1 = lundi … 7 = dimanche), off pour couper
