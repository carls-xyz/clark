{
  "name": "clark",
  "version": "0.1.0",
  "description": "Clark — agent personnel orchestrateur",
  "scripts": {
    "start": "node src/index.ts",
    "demo": "node scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/",
    "google:login": "node scripts/google-login.ts",
    "cli:install": "ln -sf \"$PWD/bin/clark.mjs\" \"$HOME/.local/bin/clark\" && echo \"clark installé dans ~/.local/bin\""
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.327",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@ui-sdk/core": "^0.1.0-beta.12",
    "@ui-sdk/web": "^0.1.0-beta.12",
    "grammy": "^1.46.0",
    "playwright-core": "^1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "clark": "bin/clark.mjs"
  }
}
